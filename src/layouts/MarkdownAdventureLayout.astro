---
import BaseLayout from './BaseLayout.astro';
import '../styles/dnd.css';

const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.title}>
  <div class="dnd-adventure">
    <div class="card">
      <h3 class="card-title">About this adventure</h3>
      <p><strong>Published:</strong> {frontmatter.pubMonth}/{frontmatter.pubDay}/{frontmatter.pubYear}</p>
      <p><strong>System:</strong> {frontmatter.system}</p>
      <p><strong>Number of Players:</strong> {frontmatter.numPlayers}</p>
      <p><strong>Level:</strong> {frontmatter.level}</p>
      <p><strong>Duration:</strong> {frontmatter.duration}</p>
      <p><strong>Synopsis:</strong> {frontmatter.description}</p>
    </div>
    <slot />
  </div>
</BaseLayout>
